# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# This project's runtime data - every one of these is generated by
# running the DB, never something to commit.
*.sst
*.sst.index
*.sst.bloom
*.sst.tmp
*.tmp
wal.log
MANIFEST.json
MANIFEST.json.tmp
MANIFEST.lock

# Benchmark scratch space (BENCHMARKS.md and benchmarks/charts/*.png
# ARE committed - they're the deliverable - only the throwaway
# data directories benchmarks build and tear down are ignored here)
benchmarks/_scratch/
demo_data/
demo_compaction/
demo_scan/

# OS cruft
.DS_Store
Thumbs.db
